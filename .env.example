# ── Capital ───────────────────────────────────────────────────────
INITIAL_CAPITAL=500000

# ── Trade sizing ──────────────────────────────────────────────────
MAX_POSITION_PCT=0.08
MAX_OPEN_POSITIONS=6
DAILY_TRADE_TARGET=5

# ── Risk ─────────────────────────────────────────────────────────
STOP_LOSS_PCT=0.015
TARGET_PCT=0.030
TRAIL_TRIGGER_PCT=0.012
MIN_RR_RATIO=1.5
MAX_DAILY_LOSS_PCT=0.03
CONSEC_LOSS_LIMIT=4

# ── Screener ─────────────────────────────────────────────────────
SCREENER_REFRESH_MIN=60
SCREENER_MAX_PICKS=15
USE_SCREENER=true

# ── Manual watchlist (used if USE_SCREENER=false) ─────────────────
NSE_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,WIPRO,SBIN,AXISBANK,BAJFINANCE,TITAN,MARUTI,SUNPHARMA,LT,TATAMOTORS,KOTAKBANK

# ── Bar settings ─────────────────────────────────────────────────
BAR_INTERVAL=5m
BAR_LOOKBACK=5d
PRODUCT_TYPE=MIS
LOOP_INTERVAL_SEC=60

# ── Strategy tuning ───────────────────────────────────────────────
RSI_BUY_LO=55.0           # minimum RSI to enter
RSI_BUY_HI=92.0           # maximum RSI to enter (avoid overbought)
RSI_SELL=45.0             # RSI below this → exit
RSI_OB=96.0               # RSI above this → overbought exit
VOL_MULT=1.5              # volume must be this × 20-bar average
MIN_DAY_CHG=0.003         # minimum day change % to enter (0.3%)

# ── Production (Render) ───────────────────────────────────────────
# Set this to your Render Redis connection string
# REDIS_URL=redis://red-xxxx:6379
